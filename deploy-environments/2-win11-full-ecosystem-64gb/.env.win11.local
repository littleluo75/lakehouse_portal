# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DEV TRÊN WINDOWS 11 (FULL ECOSYSTEM - 64GB RAM)
# ==============================================================================
NODE_TLS_REJECT_UNAUTHORIZED=0

# Keycloak SSO (Port 8080)
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/lakehouse
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=lakehouse
KEYCLOAK_CLIENT_ID=vdp-portal
KEYCLOAK_CLIENT_SECRET=vdp-portal-secret-key-2026

# Internal Services (BFF Local → Docker Compose Ports)
INTERNAL_AIRFLOW_API=http://127.0.0.1:8081/api/v1
INTERNAL_TRINO_URL=http://127.0.0.1:8083
INTERNAL_NESSIE_API=http://127.0.0.1:19120/api/v2
INTERNAL_MINIO_ENDPOINT=http://127.0.0.1:9000
INTERNAL_MINIO_ACCESS_KEY=minioadmin
INTERNAL_MINIO_SECRET_KEY=123123123
INTERNAL_OPENMETADATA=http://127.0.0.1:8585/api/v1
INTERNAL_JUPYTERHUB=http://127.0.0.1:8088/hub/api
INTERNAL_GRAFANA=http://127.0.0.1:3001

# StarRocks SQL Connection (Port 9030)
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=

# Public URLs (cho redirect/iframe)
PUBLIC_AIRFLOW_URL=http://127.0.0.1:8081
PUBLIC_GRAFANA_URL=http://127.0.0.1:3001
PUBLIC_OPENMETADATA_URL=http://127.0.0.1:8585

# Portal config
NEXTAUTH_URL=http://portal.lakehouse.local:3000
NEXTAUTH_SECRET=vdp-portal-secret-key-2026
NEXT_PUBLIC_APP_NAME="VNPT Data Lighthouse (Win11 Full Dev)"
