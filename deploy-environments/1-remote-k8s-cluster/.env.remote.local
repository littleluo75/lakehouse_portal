# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG KẾT NỐI HẠ TẦNG THẬT (*.LAKEHOUSE.LOCAL)
# ==============================================================================
# Sử dụng khi đã kết nối SSH Tunnel / VPN tới cụm RKE2
# ==============================================================================

# Bỏ qua xác thực SSL tự ký khi chạy Next.js Local kết nối qua Traefik HTTPS
NODE_TLS_REJECT_UNAUTHORIZED=0

# Keycloak SSO
KEYCLOAK_ISSUER=https://keycloak.lakehouse.local/realms/lakehouse
KEYCLOAK_INTERNAL_URL=https://keycloak.lakehouse.local
KEYCLOAK_REALM=lakehouse
KEYCLOAK_CLIENT_ID=vdp-portal
KEYCLOAK_CLIENT_SECRET=vdp-portal-oidc-client-secret-123456

# Internal Service URLs (BFF Local → SSH Tunnel Port 443 → Traefik Ingress → K8s Pods)
INTERNAL_AIRFLOW_API=https://airflow.lakehouse.local/api/v1
INTERNAL_TRINO_URL=https://trino.lakehouse.local
INTERNAL_NESSIE_API=https://nessie.lakehouse.local/api/v2
INTERNAL_MINIO_ENDPOINT=https://minio.lakehouse.local
INTERNAL_MINIO_ACCESS_KEY=minioadmin
INTERNAL_MINIO_SECRET_KEY=123123123
INTERNAL_OPENMETADATA=https://openmetadata.lakehouse.local/api/v1
INTERNAL_JUPYTERHUB=https://jupyterhub.lakehouse.local/hub/api
INTERNAL_GRAFANA=https://grafana.lakehouse.local

# StarRocks SQL Connection (IP trực tiếp NodePort K8s Cluster hoặc qua SSH Tunnel)
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=30030
STARROCKS_USER=root
STARROCKS_PASSWORD=

# Public URLs (cho redirect/iframe trên trình duyệt)
PUBLIC_AIRFLOW_URL=https://airflow.lakehouse.local
PUBLIC_GRAFANA_URL=https://grafana.lakehouse.local
PUBLIC_OPENMETADATA_URL=https://openmetadata.lakehouse.local
PUBLIC_JUPYTERHUB_URL=https://jupyterhub.lakehouse.local

# Portal config
NEXTAUTH_URL=https://portal.lakehouse.local
NEXTAUTH_SECRET=vdp-portal-secret-key-2026
NEXT_PUBLIC_APP_NAME="VNPT Data Lighthouse (Remote Cluster)"
